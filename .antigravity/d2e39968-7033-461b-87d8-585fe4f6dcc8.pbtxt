          text: "    const info = db.prepare(`PRAGMA table_info(${tableName})`).all();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return info.map(col => col.name);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } catch (err) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    console.error(`Erro ao buscar colunas da tabela ${tableName}:`, err);"
