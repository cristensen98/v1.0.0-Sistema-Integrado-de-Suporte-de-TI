rn null;\n                          }}\n                        />\n                      </PieChart>\n                    </ResponsiveContainer>\n                  </div>\n                  \n                  {/* Legenda Est\303\251tica e Fixa com Wrap */}\n                  <div className=\"flex flex-wrap justify-center gap-x-3 gap-y-1 mt-2 px-2 max-h-20 overflow-y-auto scrollbar-hide shrink-0\">\n                    {topIncidentsData.map((entry, index) => (\n                      <div key={entry.name} className=\"flex items-center gap-1 text-[9px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400\">\n                        <span className=\"w-2 h-2 rounded-full shrink-0\" style={{ backgroundColor: COLORS[index % COLORS.length] }} />\n                        <span className=\"truncate max-w-[120px]\">{entry.name} ({entry.value})</span>\n                      </div>\n                    ))}\n                  </div>\n                </>\n              ) : (\n                <div className=\"h-full flex flex-col items-center justify-center text-slate-400\">\n                  <AlertTriangle className=\"w-12 h-12 mb-4 opacity-20\" />\n                  <p className=\"text-sm font-bold uppercase tracking-widest\">Sem dados</p>\n                </div>\n              )}\n            </div>"
