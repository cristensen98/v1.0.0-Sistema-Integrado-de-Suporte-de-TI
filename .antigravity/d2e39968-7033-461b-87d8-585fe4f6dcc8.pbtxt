        replacement_content: "  return (\n    <rect \n      x={x + offset} \n      y={barY} \n      width={barWidth} \n      height={barHeight} \n      fill={fill} \n      rx={radius} \n      ry={radius} \n    />\n  );\n};\n\nfunction formatIncidentType(name: string): string {\n  if (!name) return \'Outros\';\n  const nameLower = name.toLowerCase();\n  if (nameLower.includes(\'internet\')) return \'Internet\';\n  if (nameLower.includes(\'pep\')) return \'Sistema PEP\';\n  if (nameLower.includes(\'impressora\') || nameLower.includes(\'etiqueta\')) return \'Impressora\';\n  if (nameLower.includes(\'certificado\')) return \'Certificado\';\n  if (nameLower.includes(\'hardware\') || nameLower.includes(\'mouse\') || nameLower.includes(\'teclado\') || nameLower.includes(\'monitor\')) return \'Hardware\';\n  if (nameLower.includes(\'wi-fi\') || nameLower.includes(\'wifi\') || nameLower.includes(\'sem fio\')) return \'Wi-Fi\';\n  if (nameLower.includes(\'voip\') || nameLower.includes(\'telefone\') || nameLower.includes(\'ramal\')) return \'VoIP\';\n  if (nameLower.includes(\'usu\303\241rio de rede\') || nameLower.includes(\'permiss\303\265es\') || nameLower.includes(\'email\') || nameLower.includes(\'e-mail\')) return \'Acessos\';\n  if (nameLower.includes(\'computador n\303\243o liga\') || nameLower.includes(\'fonte queimada\') || nameLower.includes(\'computador\')) return \'Computador\';\n  if (nameLower.includes(\'notas fiscais\') || nameLower.includes(\'faturamento\')) return \'Faturamento\';\n  if (nameLower.includes(\'erp\')) return \'Sistema ERP\';\n  \n  if (name.length > 20) {\n    const parts = name.split(\' \');\n    if (parts.length > 1) {\n      if (parts[0].length <= 3 && parts.length > 2) {\n        return `${parts[0]} ${parts[1]} ${parts[2]}`.substring(0, 20);\n      }\n      return `${parts[0]} ${parts[1]}`.substring(0, 20);\n    }\n    return name.substring(0, 20);\n  }\n  return name;\n}\n\nexport default function Dashboard() {"
      }
